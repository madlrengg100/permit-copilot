[Unit]
Description=Permit Copilot production frontend
After=network-online.target permit-copilot-backend.service
Wants=network-online.target
Requires=permit-copilot-backend.service

[Service]
Type=simple
User=jh12535320
Group=jh12535320
WorkingDirectory=/home/jh12535320/permit-copilot/frontend
EnvironmentFile=/etc/permit-copilot/permit-copilot.env
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=5173
# SELinux 환경에서 systemd가 홈 디렉터리의 node를 직접 exec하면 203/EXEC가 난다.
# 로그인 셸을 통해 실행하면 사용자 컨텍스트로 정상 전환된다.
ExecStart=/bin/bash -lc 'exec /usr/bin/node /home/jh12535320/permit-copilot/frontend/server.mjs'
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
