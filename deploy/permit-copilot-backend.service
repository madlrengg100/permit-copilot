[Unit]
Description=Permit Copilot FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=madlrengg100
Group=madlrengg100
WorkingDirectory=/home/madlrengg100/permit-copilot/backend
EnvironmentFile=/etc/permit-copilot/permit-copilot.env
ExecStart=/home/madlrengg100/permit-copilot/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
