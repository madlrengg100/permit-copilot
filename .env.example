# 외부 공개 주소와 허용 Origin
VWORLD_DOMAIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
APP_PORT=5173

# VWorld
VWORLD_KEY=

# API 접근 보호용 공유 토큰
APP_TOKEN=

# LLM 공급자 설정
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_BASE=

# 사용하는 공급자의 키만 입력
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
DATA_GO_KR_SERVICE_KEY=
LAW_OPEN_API_OC=
# 행안부 juso.go.kr 도로명주소 검색 승인키(무료). 건축물대장이 토지 필지 PNU가 아닌
# 건물 대표지번에 등록된 대단지·구축 아파트의 기존건물 조회 폴백에 사용한다.
JUSO_CONFM_KEY=

# OGC WFS/WMS 공간레이어. 실제 제공기관 URL과 레이어명을 확인한 뒤
# backend/app/data/spatial_layers.json 에서 enabled=true 로 전환합니다.
AGRI_WFS_URL=
AGRI_WMS_URL=
AGRI_LAYER_NAME=
FOREST_WFS_URL=
FOREST_WMS_URL=
FOREST_LAYER_NAME=
SPATIAL_LAYERS_FILE=
OGC_ALLOW_HTTP=false

# 전국 공간데이터 — Git·Docker 이미지에 넣지 않고 읽기 전용 볼륨으로 마운트한다.
# forest/, forest_inventory/, ecological_nature_map/, terrain/을 포함하는 processed
# 폴더를 지정한다. 미지정 시 ./backend/data/processed 를 사용한다.
SPATIAL_DATA_DIR=
