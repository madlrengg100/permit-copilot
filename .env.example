# 외부 공개 주소와 허용 Origin
VWORLD_DOMAIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
APP_PORT=5173

# VWorld
VWORLD_KEY=

# API 접근 보호용 공유 토큰
APP_TOKEN=

# LLM 공급자 설정
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_BASE=

# 사용하는 공급자의 키만 입력
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
DATA_GO_KR_SERVICE_KEY=
LAW_OPEN_API_OC=

# OGC WFS/WMS 공간레이어. 실제 제공기관 URL과 레이어명을 확인한 뒤
# backend/app/data/spatial_layers.json 에서 enabled=true 로 전환합니다.
AGRI_WFS_URL=
AGRI_WMS_URL=
AGRI_LAYER_NAME=
FOREST_WFS_URL=
FOREST_WMS_URL=
FOREST_LAYER_NAME=
SPATIAL_LAYERS_FILE=
OGC_ALLOW_HTTP=false
